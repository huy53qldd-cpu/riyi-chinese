rules_version = '2';

// =============================================================================
// QUY TẮC BẢO MẬT FIRESTORE — Riyi
// =============================================================================
// Mỗi người dùng chỉ đọc và ghi được ĐÚNG tài liệu của chính mình
// (nguoiDung/{uid}), và chỉ khi đã đăng nhập. Mọi nơi khác đều bị chặn.
//
// Khi ghi, tài liệu chỉ được có các trường: caiDat, daHoc, tapViet, mucTieu,
// nhatKy, chuoi, capNhatLuc. Hai bảng daHoc, tapViet không được quá 5000 mục,
// nhật ký không quá 120 ngày (app tự dọn còn 70 ngày), để chặn ghi rác làm đầy
// dung lượng gói miễn phí.
//
// Sau khi sửa file này, đưa lên Firebase bằng:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /nguoiDung/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['caiDat', 'daHoc', 'tapViet', 'mucTieu', 'loTrinh', 'nhatKy', 'chuoi', 'thongBao', 'capNhatLuc'])
        && (!('daHoc' in request.resource.data) || request.resource.data.daHoc.size() <= 5000)
        && (!('tapViet' in request.resource.data) || request.resource.data.tapViet.size() <= 5000)
        && (!('nhatKy' in request.resource.data) || request.resource.data.nhatKy.size() <= 120);
    }

    // Hàng chờ thông báo QUẢN TRỊ (quyết định 18.57). DUY NHẤT tài khoản quản
    // trị được đọc và tạo; mã này phải trùng UID_QUAN_TRI trong
    // src/thong-bao/quanTri.js. Chỉ được tạo mới ở trạng thái "cho", đúng 4
    // trường, độ dài giới hạn; KHÔNG ai sửa/xoá được từ app. Việc đổi trạng
    // thái sang "da-gui" do GitHub Actions làm bằng khoá quản trị (bỏ qua luật).
    match /thongBaoCho/{ma} {
      allow read: if request.auth != null
        && request.auth.uid == 'NGEhCGlJnwXQTJpgDH5bMPNPgwT2';

      allow create: if request.auth != null
        && request.auth.uid == 'NGEhCGlJnwXQTJpgDH5bMPNPgwT2'
        && request.resource.data.keys().hasOnly(['tieuDe', 'than', 'taoLuc', 'trangThai'])
        && request.resource.data.tieuDe is string
        && request.resource.data.tieuDe.size() >= 1
        && request.resource.data.tieuDe.size() <= 60
        && request.resource.data.than is string
        && request.resource.data.than.size() >= 1
        && request.resource.data.than.size() <= 300
        && request.resource.data.trangThai == 'cho'
        && request.resource.data.taoLuc == request.time;
    }

    // Chặn tất cả nơi còn lại (kể cả heThong/nhacHoc: chỉ GitHub Actions ghi)
    match /{tatCa=**} {
      allow read, write: if false;
    }
  }
}
