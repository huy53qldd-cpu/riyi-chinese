# =============================================================================
# CẤU HÌNH FIREBASE — file MẪU
# =============================================================================
# Cách dùng: sao chép file này thành ".env" (cùng thư mục), rồi điền 6 giá trị
# lấy từ Firebase Console. Hướng dẫn từng bước nằm trong README.md, mục
# "Kết nối Firebase".
#
# File ".env" thật KHÔNG được đưa lên kho Git (đã chặn sẵn trong .gitignore).
# Ghi chú: cấu hình web của Firebase không phải mật khẩu, nhưng vẫn không đưa lên
# kho công khai để gọn gàng và tránh người lạ dùng ké.
# =============================================================================

VITE_FIREBASE_API_KEY=
# Tên miền của trang đăng nhập Google. Nên dùng CHÍNH địa chỉ app đang chạy
# (ví dụ "riyi-chinese.web.app"), không dùng "...firebaseapp.com", để iPhone
# không làm mất phiên đăng nhập (quyết định 18.10). Muốn vậy phải thêm địa chỉ
# https://<địa chỉ app>/__/auth/handler vào Google Cloud (xem README).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
