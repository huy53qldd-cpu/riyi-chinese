# --- Thư viện tải về, không cần lưu vào kho ---
node_modules/

# --- Kết quả đóng gói, tự sinh lại được ---
dist/
dist-ssr/
*.local

# --- Font GỐC chưa cắt, tổng cộng khoảng 27 MB ---
# Không lưu vào kho cho nhẹ. Tải lại bằng lệnh: npm run tai-font
# Font ĐÃ CẮT (public/fonts) thì VẪN lưu, vì app cần để chạy.
cong-cu/font-goc/

# --- File kết quả tạm của công cụ ---
cong-cu/ket-qua-so-sanh-tu-dang.png

# --- Nhật ký lỗi ---
logs/
*.log
npm-debug.log*

# --- File của trình soạn thảo và hệ điều hành ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Firebase (sẽ dùng từ giai đoạn 6) ---
.firebase/
firebase-debug.log
.env
.env.local

# --- Lich su tro chuyen cua Claude Code ---
# Khong bao gio dua vao kho cong khai: co the chua noi dung liet ke thu muc may.
*.jsonl
!src/du-lieu/**/*.jsonl

# --- Nguồn mở tải về để dựng dữ liệu (tự tải lại bằng npm run dung-chu-han) ---
cong-cu/nguon-mo/

# --- Bộ nét chữ Nhật KanjiVG tải về (273 MB, chỉ để công cụ đọc) ---
kanji_kakijun/

# --- Đề thi HSK GỐC (pdf + mp3), công cụ cong-cu/dung-de-thi.py dựng ra public/du-lieu/thi-thu/ ---
de_thi_HSK/

# --- Giáo trình tham khảo (bản quyền của nhà xuất bản), KHÔNG đưa lên GitHub ---
Giao_trinh/

# --- Âm thanh + ảnh cắt từ giáo trình (quyết định 18.68, phương án A) ---
# Chỉ nằm trên máy và được tải thẳng lên Firebase Hosting khi triển khai.
# Mất thì dựng lại: python cong-cu/nen-am-thanh-co-ban.py && python cong-cu/cat-anh-co-ban.py
public/du-lieu/co-ban/*/am/
public/du-lieu/co-ban/*/hinh/
